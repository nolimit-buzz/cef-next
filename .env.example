NEXT_PUBLIC_STRAPI_URL=

# Brevo transactional email. Required by /api/contact, /api/investor-enquiry
# and /api/submit-project — all three return 500 "Email service is not
# configured." without BREVO_API_KEY. Set it in the Netlify UI for production;
# it must not be committed here.
# BREVO_FROM_EMAIL must sit on a Brevo-authenticated domain. Use a dedicated
# no-reply address rather than support@ — sending from the same mailbox that
# receives the notification trips spam filters. Replies still reach the
# submitter because replyTo is set per-request in the API routes.
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@cleanenergyfund.ng
BREVO_FROM_NAME=Clean Energy Fund Website
CONTACT_TO_EMAIL=support@cleanenergyfund.ng
